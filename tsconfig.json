{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "outDir": "dist",
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop":true,
    "skipLibCheck": true,
    "target": "ES2022",
    "paths": {
      "@/*": ["./src/*"],
      "@@tests/*": ["./tests/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts"]
}
